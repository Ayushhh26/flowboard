{
  "name": "flowboard-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for FlowBoard — six board tools (get_board, search_cards, create_card_from_text, etc.) for Cursor, Claude Code, and Claude Desktop over personal API tokens.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kanban",
    "cursor",
    "claude",
    "claude-code",
    "flowboard",
    "ai",
    "agent"
  ],
  "homepage": "https://github.com/Ayushhh26/flowboard/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Ayushhh26/flowboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayushhh26/flowboard.git",
    "directory": "packages/mcp-server"
  },
  "license": "MIT",
  "author": "Ayush <https://github.com/Ayushhh26>",
  "type": "module",
  "bin": {
    "flowboard-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
