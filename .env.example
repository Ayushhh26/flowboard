# PostgreSQL connection string (pooled — used by Prisma at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection string (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase project URL and anon key (from Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Set to "true" to show the Demo Mode toggle in the UI
NEXT_PUBLIC_DEMO_MODE="true"

# Groq — Smart Add natural-language card parsing (server-only, https://console.groq.com)
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="openai/gpt-oss-20b"
# (default if unset; must support json_schema — see Groq structured-outputs docs)

# Personal API token for MCP / agents (create in app: user menu → API tokens)
# FLOWBOARD_API_TOKEN="fb_..."
# FLOWBOARD_BASE_URL="http://localhost:3000"

# Playwright E2E (optional — local/CI only, never commit real credentials)
# PLAYWRIGHT_EMAIL="you@example.com"
# PLAYWRIGHT_PASSWORD="your-password"
# PLAYWRIGHT_BOARD_ID="<board-uuid-from-url>"  # optional — omit to use first board on home page
